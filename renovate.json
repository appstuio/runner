{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Node tool-cache release tags atomically",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\nARG NODE_\\d+_RELEASE=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update Bun while retaining the former primary release",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\nARG BUN_COMPAT_VERSION=\\S+\\nARG BUN_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^bun-v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}} packageName={{{packageName}}}\\nARG BUN_COMPAT_VERSION={{{currentValue}}}\\nARG BUN_VERSION={{{newValue}}}"
    },
    {
      "customType": "regex",
      "description": "Update checked-in ARC values to the newest published image digest",
      "managerFilePatterns": ["/^deploy/byo(?:-large)?-values\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io/appstuio/runner):(?<currentValue>latest)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Node 22 cache on its release line",
      "matchDepNames": ["node-22-toolcache"],
      "allowedVersions": "/^22\\./"
    },
    {
      "description": "Keep the Node 24 cache on its release line",
      "matchDepNames": ["node-24-toolcache"],
      "allowedVersions": "/^24\\./"
    },
    {
      "description": "GHCR does not expose release timestamps for the global age gate",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/actions/actions-runner",
        "ghcr.io/appstuio/runner"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
